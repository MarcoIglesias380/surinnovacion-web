# Variables del endpoint POST /api/contacto.
# Copiar a .env.local para desarrollo y configurar en Vercel para produccion.
# Pasos completos en docs/contacto-setup.md.
#
# Sin estas variables el formulario responde error y ofrece WhatsApp.
# Cada canal se activa por separado: el almacen protege el lead, el correo avisa.

# Notificacion por correo (Resend)
RESEND_API_KEY=
LEAD_NOTIFY_TO=contacto@surinnovacion.cl
LEAD_NOTIFY_FROM=SurInnovacion <web@surinnovacion.cl>

# Almacen durable del lead (Supabase). La service_role solo vive en el servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LEADS_TABLE=leads
